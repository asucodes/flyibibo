# ============================================================
# flyibibo - AI travel agent (prototype)
# ============================================================
# Per-tier provider routing: the value is "<provider>:<model>".
# parse_llm() splits on the FIRST colon, so OpenRouter model IDs
# containing a slash work fine.
# ============================================================

# --- Fast tier -> Groq -------------------------------------
# Drives the parallel fan-out agents (flights, attractions,
# food, hotels). Latency matters most here because they run
# concurrently. gpt-oss-120b: ~500 tok/s, 131k context.
# NOTE: llama-3.3-70b-versatile is Enterprise/Contact-Sales
# only as of 2026 - do not use it on a free key.
FAST_LLM=groq:openai/gpt-oss-120b

# --- Smart tier -> OpenRouter ------------------------------
# Drives the master synthesizer (the pitch) and long-form
# assembly. 1M context, $0.75/$3.75 per 1M tokens.
# Stronger-but-pricier swap: anthropic/claude-sonnet-5
SMART_LLM=openrouter:google/gemini-3.8-flash

# --- Strategic tier -> OpenRouter --------------------------
# Planning / brief extraction / slot filling.
STRATEGIC_LLM=openrouter:google/gemini-3.8-flash

# Global sampling temperature. Research stages want this LOW
# (facts, not invention); only the synthesizer benefits from
# headroom. gpt-researcher exposes this globally, so we keep
# it low and push the creative budget into the synthesizer
# prompt instead.
TEMPERATURE=0.2

# ============================================================
# API KEYS - fill these in
# ============================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenRouter client-side throttle (requests/second).
# The provider layer builds an InMemoryRateLimiter from this.
OPENROUTER_LIMIT_RPS=1.0

# ============================================================
# Retriever - keyless
# ============================================================
# duckduckgo needs no API key (pip install ddgs).
# Alternatives requiring keys: tavily, brave, serper, exa.
RETRIEVER=duckduckgo

# ============================================================
# Report shaping
# ============================================================
TOTAL_WORDS=1200
LANGUAGE=english
CURATE_SOURCES=false

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000
VERBOSE=true

# ============================================================
# Travel layer (flyibibo-specific)
# ============================================================
# mock      -> seeded fixtures, no key, offline-safe
# serpapi   -> live Google Flights via SerpAPI (needs SERPAPI_API_KEY)
FLIGHT_PROVIDER=mock
SERPAPI_API_KEY=

# POI grounding + photography. Both keyless.
#   wikivoyage -> destination prose, must-sees, districts
#   wikimedia  -> real photographs of the actual landmarks
POI_SOURCE=wikivoyage
PHOTO_SOURCE=wikimedia

# Wikimedia requires a descriptive User-Agent per their policy.
WIKIMEDIA_USER_AGENT=flyibibo/0.1 (prototype; contact onepetaflop@gmail.com)
